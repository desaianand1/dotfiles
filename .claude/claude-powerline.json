{
  "theme": "catppuccin-macchiato",
  "display": {
    "style": "powerline",
    "colorCompatibility": "auto",
    "segments": {
      "directory": { "enabled": true, "showBasename": true },
      "git": {
        "enabled": true,
        "showSha": false,
        "showWorkingTree": true,
        "showOperation": true,
        "showTag": true,
        "showTimeSinceCommit": true,
        "showStashCount": true,
        "showUpstream": true,
        "showRepoName": true
      },
      "model": { "enabled": true },
      "effort": { "enabled": true },
      "session": { "enabled": false },
      "block": { "enabled": false },
      "context": { "enabled": true, "showPercentageOnly": false },
      "cost": { "enabled": true }
    }
  },
  "modelContextLimits": {
    "sonnet": 200000,
    "opus": 200000
  }
}
